# Production: APP_ENV=production, APP_DEBUG=false, APP_URL=https://<domain>, APP_KEY from "php artisan key:generate".
APP_NAME="We Are Morocco DMC"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wearemorocco
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# Guest full-page cache (cleared on any content change). Set false to switch it off.
PAGE_CACHE=true
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Website form emails (Phase 4). Locally MAIL_MAILER=log writes them to storage/logs/laravel.log.
# Live: MAIL_MAILER=smtp, MAIL_SCHEME=smtps (port 465) or null (587, STARTTLS), MAIL_HOST, MAIL_PORT, MAIL_USERNAME,
# MAIL_PASSWORD (only in the server .env, never in git), MAIL_FROM_ADDRESS on the site domain, and
# QUEUE_CONNECTION=database with a running "php artisan queue:work" so the queued emails are sent.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Seeder only (php artisan db:seed): admin@wearemorocco.local password; Editor/Sales test accounts only if set.
ADMIN_PASSWORD=
EDITOR_PASSWORD=
SALES_PASSWORD=
